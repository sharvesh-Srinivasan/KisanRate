# ─── Docker Compose (local dev) ───────────────────────────────────────────────
# When running `docker compose up` these values configure all services.
# For local dev: REACT_APP_* should point to localhost.
# For production: these are set as environment variables / secrets in Render / Vercel.

# Client
REACT_APP_API_URL=http://localhost:4000
REACT_APP_SOCKET_URL=http://localhost:4000

# Server
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=root
DB_NAME=kisanrate
DB_PORT=3306
JWT_SECRET=your_super_secret_jwt_key
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
AGMARKNET_API_KEY=your_agmarknet_api_key
AGMARKNET_STATES=Tamil Nadu
ML_SERVICE_URL=https://kisanrate-ml.onrender.com
PORT=4000

# ML (uses same DB_* names)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=root
DB_NAME=kisanrate
DB_PORT=3306
