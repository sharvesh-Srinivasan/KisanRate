# Example environment variables for KisanRate server
# Copy this file to .env and fill in the values. NEVER commit your .env with secrets.

# MySQL / Aiven DB settings
DB_HOST=your-db-host
DB_PORT=3306
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=kisanrate

# JWT secret for admin authentication
JWT_SECRET=replace_this_with_a_secure_random_string

# Agmarknet (optional)
AGMARKNET_API_KEY=your_agmarknet_api_key
AGMARKNET_STATES=Tamil Nadu

# Twilio credentials (for WhatsApp sandbox / production)
# Example TWILIO_ACCOUNT_SID looks like ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio WhatsApp 'from' number (sandbox default): whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Optional: protect the test-send endpoint with a secret header
WHATSAPP_TEST_SECRET=

# Optional: frontend sandbox join settings (used by client build)
REACT_APP_WHATSAPP_SANDBOX_NUMBER=+14155238886
REACT_APP_WHATSAPP_JOIN_CODE=join-kisanrate

# Port
PORT=4000

# Notes:
# 1) After creating a real .env file, restart the server (npm start) to apply changes.
# 2) For local Twilio Sandbox testing, keep TWILIO_WHATSAPP_FROM as the sandbox number
#    and invite test users to send the join code to that number from their WhatsApp app.
